# Required: Supabase (or any Postgres) connection string.
# Get it from Supabase: Project Settings → Database → Connection string (URI).
# If your password contains #, ?, &, =, @, etc., URL-encode them (e.g. # → %23).
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT signing secret; set in production.
# AGENTCHAT_TOKEN_SECRET=your-secret

# API bind (optional)
# HOST=127.0.0.1
# PORT=8787

# TUI/CLI: API base URL (optional, for clients)
# AGENTCHAT_API_URL=http://127.0.0.1:8787
