# Required: Supabase (or any Postgres) connection string.
# Get it from Supabase: Project Settings → Database → Connection string (URI).
# If your password contains #, ?, &, =, @, etc., URL-encode them in the URL:
#   # → %23   ? → %3F   & → %26   = → %3D   @ → %40
# Example: password "mypass#123" → use ...:mypass%23123@...
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT signing secret; set in production.
# AGENTCHAT_TOKEN_SECRET=your-secret

# API bind (optional)
# HOST=127.0.0.1
# PORT=8787

# TUI/CLI: API base URL (optional, for clients)
# AGENTCHAT_API_URL=http://127.0.0.1:8787

# CORS: allow cross-origin requests only from these origins (optional).
# If unset, same-origin only. Single origin or comma-separated list.
# CORS_ORIGIN=https://your-frontend.example.com
# CORS_ORIGINS=https://app.example.com,https://www.example.com
