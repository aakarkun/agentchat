{
  "name": "agentchat",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "bin": {
    "agentchat": "apps/tui/src/simple-cli.ts"
  },
  "scripts": {
    "api": "bun apps/api/src/index.ts",
    "api:dev": "NODE_ENV=development bun --watch apps/api/src/index.ts",
    "tui": "bun apps/tui/src/index.tsx",
    "tui:simple": "bun apps/tui/src/index.tsx --simple",
    "tui:line": "bun apps/tui/src/index.tsx --line-input",
    "cli": "bun apps/tui/src/simple-cli.ts",
    "whitepaper": "bun run --cwd apps/whitepaper dev",
    "whitepaper:build": "bun run --cwd apps/whitepaper build",
    "whitepaper:preview": "bun run --cwd apps/whitepaper preview",
    "basic-chat": "bun run --cwd packages/react-sdk build && bun run --cwd apps/basic-chat dev",
    "basic-chat:build": "bun run --cwd apps/basic-chat build",
    "docs": "npx mintlify dev",
    "docs:dev": "npx mintlify dev",
    "test": "bun test"
  }
}
